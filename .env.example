# classUNO Environment Variables

# App URL (auto-injected in AI Studio or configured for deployment)
APP_URL="http://localhost:3000"
VITE_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Real-time WebSocket server URL (leave empty to connect to the same host/port)
VITE_SOCKET_URL=""
NEXT_PUBLIC_SOCKET_URL=""

# Database URL (PostgreSQL / Supabase connection string)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/classuno"

# WebRTC STUN & TURN servers for Voice Chat
NEXT_PUBLIC_STUN_SERVER="stun:stun.l.google.com:19302"
VITE_STUN_SERVER="stun:stun.l.google.com:19302"
NEXT_PUBLIC_TURN_SERVER=""
VITE_TURN_SERVER=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# AI Studio injected variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
